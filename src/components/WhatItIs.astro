---
import SectionLink from './SectionLink.astro';

const parts = [
	{
		name: 'Station',
		role: 'the service',
		body: 'Each artist hosts their own music catalog.',
	},
	{
		name: 'qnch',
		role: 'the network',
		body: 'Each Station instance is a participant in a peer-to-peer network.',
	},
	{
		name: 'FanSociety',
		role: 'fan clubs',
		body: 'A crowdfunding and patronage service, integrated natively with Station.',
	},
];
---

<section class="section section--bleed" id="what">
	<div class="wrap">
		<div class="head inset">
			<div class="head-text">
				<p class="eyebrow">Get ready for something <strong>different</strong></p>
				<h2>Three services, no platforms</h2>
			</div>
			<p class="margin-note">The Sweet Spot for DIYing without being isolated</p>
		</div>

		<div class="grid">
			{
				parts.map((part) => (
					<article class="part">
						<div class="part-head">
							<h3>{part.name}</h3>
							<span class="role">{part.role}</span>
						</div>
						<p>{part.body}</p>
					</article>
				))
			}
		</div>

		<div class="tail inset">
			<SectionLink slug="services" label="more about the three services" />
		</div>
	</div>
</section>

<style>
	/* Reads as a directory listing rather than a card grid: three columns
	   running to the window edge, divided by hairlines that go floor to
	   ceiling. The heading sits above it, inset to the gutter. */

	.head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: clamp(1.5rem, 4vw, 3rem);
		flex-wrap: wrap;
		margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
	}

	.head-text {
		flex: 1 1 28rem;
	}

	.head .margin-note {
		flex: 0 1 auto;
		margin-bottom: 0.4rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		background: var(--rule);
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}

	.part {
		background: var(--black);
		padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.25rem);
	}

	/* Type in the outer columns lines up with the page gutter. */
	.part:first-child {
		padding-left: var(--gutter);
	}

	.part:last-child {
		padding-right: var(--gutter);
	}

	.part-head {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
		flex-wrap: wrap;
		margin-bottom: 1rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--mint-rule);
	}

	h3 {
		color: var(--mint);
	}

	.role {
		font-size: 0.68rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--gray-dim);
	}

	.part p {
		font-size: 0.85rem;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.78);
	}

	.tail {
		margin-top: clamp(0.5rem, 1.5vw, 1rem);
	}

	@media (max-width: 60rem) {
		.grid {
			grid-template-columns: 1fr;
		}

		.part,
		.part:first-child,
		.part:last-child {
			padding-left: var(--gutter);
			padding-right: var(--gutter);
		}
	}
</style>
