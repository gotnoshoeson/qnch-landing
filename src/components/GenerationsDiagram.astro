---
/**
 * GenerationsDiagram — FanPin generations over an artist's career.
 *
 * The plate and its caption only; the section, heading, lede and margin note
 * live at the call site.
 *
 * A generation is a lane that opens when the artist declares it and runs
 * rightward forever. Opening the next one caps the previous lane (no more of
 * those pins can be minted) without ending it (the pins already minted don't
 * lapse). Boundary spacing is deliberately uneven — there is no schedule.
 */
interface Generation {
  /** x where the artist opens this generation (200 = now, 50px per month) */
  x: number;
  /** y baseline of this generation's lane */
  y: number;
  /** the boundary label above the lane block */
  boundaryLabel: string;
  /** the lane label, sitting just above the lane */
  laneLabel: string;
  /** x positions of pins minted while this generation was open */
  pins: number[];
  /** note beneath the cap, where the next generation closes this one */
  capNote?: string;
}

interface Props {
  caption?: string;
  title?: string;
  subtitle?: string;
  pinUnitLabel?: string;
  generations?: Generation[];
  ticks?: { x: number; label: string }[];
  notes?: string[];
  showBoundaries?: boolean;
  showFirstGenAccent?: boolean;
  class?: string;
}

const {
  caption = 'fanpin generations — boundaries are illustrative',
  title = 'FANPIN GENERATIONS',
  subtitle = 'FANSOCIETY',
  pinUnitLabel = '1 = 1 PIN',
  generations = [
    {
      x: 200, y: 240,
      boundaryLabel: 'GEN 1 OPENS',
      laneLabel: 'GEN 1 — THE FIRST FANS. LIFETIME MEMBERSHIP.',
      pins: [230, 285, 340, 395],
      capNote: 'CREATE NEW GEN ANYTIME, ON THE FLY',
    },
    {
      x: 425, y: 340,
      boundaryLabel: 'GEN 2 OPENS — GEN 1 CLOSES',
      laneLabel: 'GEN 2',
      pins: [455, 515, 575, 640, 705, 770, 835],
      capNote: 'GEN 2 LOCKED IN',
    },
    {
      x: 875, y: 440,
      boundaryLabel: 'GEN 3 OPENS — GEN 2 CLOSES',
      laneLabel: 'GEN 3',
      pins: [905, 970, 1035, 1100, 1160],
    },
  ],
  ticks = [
    { x: 200, label: 'NOW' },
    { x: 350, label: '3 MO' },
    { x: 500, label: '6 MO' },
    { x: 650, label: '9 MO' },
    { x: 800, label: '12 MO' },
    { x: 950, label: '15 MO' },
    { x: 1100, label: '18 MO' },
  ],
  notes = [
    'A GENERATION OPENS WHEN THE ARTIST SAYS SO. THERE IS NO SCHEDULE AND NO SET NUMBER OF THEM.',
    'OPENING A NEW GENERATION CLOSES THE LAST ONE. NO MORE OF THOSE PINS CAN EVER BE MINTED.',
    "NOTHING CLOSES A PIN ITSELF. IT RECORDS WHEN A FAN ARRIVED, AND THAT DOESN'T CHANGE.",
    'ARTISTS GRANT CATALOG ACCESS BY GENERATION. THAT CHOICE IS THEIRS TOO.',
  ],
  showBoundaries = true,
  showFirstGenAccent = true,
  class: className,
} = Astro.props;

const LANE_END = 1188;
const AXIS_Y = 500;
const BLOCK_TOP = 180;
const BLOCK_BOTTOM = 470;

// boundary verticals break around each lane-label band so no rule crosses a label
const labelBands = generations.map((g) => [g.y - 35, g.y - 8]);
const boundarySegments = generations.flatMap((g) => {
  const cuts = labelBands.filter(([top, bot]) => bot > BLOCK_TOP && top < BLOCK_BOTTOM);
  let segs: [number, number][] = [[BLOCK_TOP, BLOCK_BOTTOM]];
  for (const [top, bot] of cuts) {
    segs = segs.flatMap(([a, b]) => {
      if (bot <= a || top >= b) return [[a, b] as [number, number]];
      const out: [number, number][] = [];
      if (top > a) out.push([a, top]);
      if (bot < b) out.push([bot, b]);
      return out;
    });
  }
  return segs.map(([y1, y2]) => ({ x: g.x, y1, y2 }));
});

// each lane is capped where the next generation opens
const caps = generations
  .map((g, i) => ({ gen: g, next: generations[i + 1] }))
  .filter((p) => p.next)
  .map((p) => ({ x: p.next!.x, y: p.gen.y, note: p.gen.capNote, first: p.gen === generations[0] }));
---

<figure class:list={['gn-plate', className]}>
  <svg viewBox="0 0 1248 678" role="img" aria-label={caption}>
    <defs>
      <marker id="gnArrowMint" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" fill="#adebb3" />
      </marker>
      <marker id="gnArrowWhite" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" fill="#ffffff" />
      </marker>
    </defs>

    <text x="32" y="96" class="gn-label">{title}</text>
    <text x="32" y="118" class="gn-axis">{subtitle}</text>

    {showBoundaries && (
      <g>
        <g stroke="#5a5a5a" stroke-dasharray="2 6">
          {boundarySegments.map((s) => <line x1={s.x} y1={s.y1} x2={s.x} y2={s.y2} />)}
        </g>
        <g class="gn-tick">
          {generations.map((g) => <text x={g.x + 12} y="170">{g.boundaryLabel}</text>)}
        </g>
      </g>
    )}

    {generations.map((g, i) => {
      const mint = i === 0 && showFirstGenAccent;
      const cap = caps.find((c) => c.y === g.y);
      return (
        <g>
          <text x={g.x + 12} y={g.y - 18} class={mint ? 'gn-mint' : 'gn-label'}>{g.laneLabel}</text>
          <line
            x1={g.x} y1={g.y} x2={LANE_END} y2={g.y}
            stroke={mint ? '#adebb3' : '#ffffff'}
            stroke-opacity={mint ? 1 : 0.62}
            stroke-width="2"
            marker-end={mint ? 'url(#gnArrowMint)' : 'url(#gnArrowWhite)'}
          />
          <g fill="#000000" stroke={mint ? '#adebb3' : '#ffffff'} stroke-opacity={mint ? 1 : 0.62} stroke-width="2">
            {g.pins.map((x) => <circle cx={x} cy={g.y} r="4" />)}
          </g>
          {cap && (
            <g>
              <line
                x1={cap.x} y1={g.y - 10} x2={cap.x} y2={g.y + 10}
                stroke={mint ? '#adebb3' : '#ffffff'}
                stroke-opacity={mint ? 1 : 0.62}
                stroke-width="2"
              />
              {cap.note && <text x={cap.x + 12} y={g.y + 26} class="gn-tick">{cap.note}</text>}
            </g>
          )}
        </g>
      );
    })}

    <text x="188" y={generations[0].y + 4} class="gn-axis" text-anchor="end">{pinUnitLabel}</text>

    <line x1="200" y1={AXIS_Y} x2={LANE_END} y2={AXIS_Y} stroke="#ffffff" stroke-opacity="0.32" />
    <g stroke="#ffffff" stroke-opacity="0.32">
      {ticks.map((t) => <line x1={t.x} y1={AXIS_Y} x2={t.x} y2={AXIS_Y + 8} />)}
    </g>
    <g class="gn-tick">
      {ticks.map((t) => <text x={t.x} y={AXIS_Y + 28}>{t.label}</text>)}
    </g>

    <g class="gn-axis">
      {notes.map((n, i) => <text x="200" y={574 + i * 22}>{n}</text>)}
    </g>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .gn-plate {
    margin: 0;
    border: 1px solid var(--rule);
  }
  .gn-plate svg {
    width: 100%;
    display: block;
    background: #000;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }
  .gn-plate figcaption {
    border-top: 1px solid var(--rule);
    padding: 11px 14px;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gray-dim);
  }
  .gn-tick  { fill: #8a8a8a; font-size: 11px; letter-spacing: 2px; }
  .gn-label { fill: #ffffff; font-size: 11px; letter-spacing: 2px; }
  .gn-mint  { fill: #adebb3; font-size: 11px; letter-spacing: 2px; }
  .gn-axis  { fill: #5a5a5a; font-size: 11px; letter-spacing: 2.4px; }
</style>
