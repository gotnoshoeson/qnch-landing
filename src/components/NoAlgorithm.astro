---
import { Image } from 'astro:assets';
import SectionLink from './SectionLink.astro';
import listenerApp from '../assets/listener-app.png';
---

<section class="section" id="discovery">
	<div class="wrap">
		<div class="layout">
			<div class="lead">
				<p class="eyebrow">Discovery</p>
				<h2>Bye-bye algorithms</h2>

				<figure class="shot">
					<Image
						src={listenerApp}
						alt="The qnch listener app: a dark interface with Search, Library and Wallet in the header, the Station wordmark, and a card reading Artist Operated."
						widths={[400, 600, 900, 1200]}
						sizes="(max-width: 40rem) 100vw, (max-width: 78rem) 50vw, 592px"
						loading="lazy"
						decoding="async"
					/>
					<figcaption>the listener app — no browse page, no charts</figcaption>
				</figure>
			</div>

			<div class="text">
				<p class="lede">
					No recommendation engine. No browse page. No directory.
				</p>
				<p>
					Streaming platforms didn't only take over hosting, distribution and payment. They took over discovery,
					and recommendations.
				</p>
				<p>
					Station isn't aimed at replacing this model, but at breaking it apart and redistributing it.
					Reviewers, critics, DJs, blogs, record shops, magazines.
					There's little room for them if a platform does it all.
				</p>

				<div class="url">
					<span class="url-label">artist page</span>
					<code>beta.qnch.network/artist/<span class="mint">your-namespace</span></code>
				</div>

				<SectionLink slug="discovery" />
			</div>
		</div>
	</div>
</section>

<style>
	.layout {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.text p {
		color: rgba(255, 255, 255, 0.78);
		font-size: 0.9rem;
		line-height: 1.75;
	}

	.text p + p {
		margin-top: 1.1rem;
	}

	.text .lede {
		color: rgba(255, 255, 255, 0.9);
	}

	.url {
		margin-top: 2rem;
		border: 1px solid var(--rule);
		padding: 1rem 1.1rem;
		transform: rotate(-0.6deg);
		background: rgba(255, 255, 255, 0.02);
	}

	.url-label {
		display: block;
		font-size: 0.6rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--gray-dim);
		margin-bottom: 0.5rem;
	}

	code {
		font-family: var(--mono);
		font-size: clamp(0.72rem, 0.66rem + 0.3vw, 0.88rem);
		word-break: break-all;
	}

	/* Screenshot plate: hairline frame, mono caption set like a zine credit. */
	.shot {
		margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
		border: 1px solid var(--rule);
		background: var(--black);
	}

	/* :global because <Image> renders the <img> outside this component's scope. */
	.shot :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.shot figcaption {
		font-size: 0.65rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--gray-dim);
		padding: 0.75rem 0.9rem;
		border-top: 1px solid var(--rule);
	}
</style>
