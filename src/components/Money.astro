---
import SectionLink from './SectionLink.astro';
---

<section class="section invert noise" id="money">
	<div class="wrap">
		<span class="numeral" aria-hidden="true">04</span>

		<div class="head">
			<div>
				<p class="eyebrow">Revenue split</p>
				<h2>Sovereign payments, minimally extractive</h2>
			</div>
			<span class="split" aria-label="zero percent to Station, one hundred percent to you">
				<em>0%</em>
				<span class="bar" aria-hidden="true"></span>
				<em>100%</em>
				<span class="split-key">station | you</span>
			</span>
		</div>

		<div class="body">
			<div class="col">
				<p class="lede">
					Station is launching with zero rev share. You keep all of your income.
				</p>
				<p>
					Nobody has built music distribution this way before, and taking a chance on something
					unproven should be worth more than showing up once it's safe. So the advantage is
					<strong>built in</strong>, not promised.
				</p>
				<p>
					As Station grows, the rate for artists joining later can rise. Yours doesn't move —
					whatever your split was on the day you started is the split it keeps, permanently. The
					earliest artists hold the best terms anyone will ever have.
				</p>
			</div>

			<div class="col">
				<blockquote>
					The protection isn't that we promise not to raise your rate. It's that we can't.
				</blockquote>
			</div>
		</div>

		<SectionLink slug="revenue" />
	</div>
</section>

<style>
	/* Hard-cut inversion — the one section that looks nothing like the rest. */
	.invert {
		background: var(--white);
		color: var(--black);
		border-top: 1px solid var(--black);
	}

	.invert .numeral {
		-webkit-text-stroke: 1px rgba(0, 0, 0, 0.22);
	}

	.invert .eyebrow {
		color: #1c7f3e;
	}

	.head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		flex-wrap: wrap;
		padding-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
		border-bottom: 2px solid var(--black);
	}

	.split {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		position: relative;
		padding-bottom: 1.4rem;
		transform: rotate(-1deg);
	}

	.split em {
		font-family: var(--display);
		font-style: normal;
		font-size: clamp(2.25rem, 6vw, 4rem);
		line-height: 0.85;
		letter-spacing: -0.04em;
	}

	.split em:last-of-type {
		color: #158a3f;
	}

	.bar {
		width: 1px;
		height: clamp(2rem, 5vw, 3.25rem);
		background: var(--black);
	}

	.split-key {
		position: absolute;
		bottom: 0;
		left: 0;
		font-size: 0.62rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgba(0, 0, 0, 0.55);
	}

	.body {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
		gap: clamp(2rem, 5vw, 4rem);
		padding-top: clamp(2rem, 4vw, 3rem);
	}

	.col p + p {
		margin-top: 1.1rem;
	}

	.body p {
		color: rgba(0, 0, 0, 0.82);
		font-size: 0.85rem;
		line-height: 1.75;
	}

	.body .lede {
		font-size: clamp(1rem, 0.94rem + 0.32vw, 1.2rem);
		line-height: 1.55;
		color: var(--black);
	}

	.body strong {
		font-weight: 700;
		color: var(--black);
	}

	blockquote {
		font-family: var(--display);
		font-size: clamp(1.4rem, 3.4vw, 2.4rem);
		line-height: 1.02;
		letter-spacing: -0.025em;
		text-transform: uppercase;
		border-left: 4px solid #158a3f;
		padding-left: clamp(0.9rem, 2vw, 1.4rem);
		margin-bottom: 1.75rem;
		max-width: 22ch;
	}

	.aside {
		max-width: 46ch;
	}

	.aside + .aside {
		margin-top: 1.1rem;
	}

	/* SectionLink ships light-on-dark; this section is inverted, so restate it.
	   :global because the link is rendered by a child component. */
	.invert :global(.section-link) {
		color: rgba(0, 0, 0, 0.62);
		border-top-color: rgba(0, 0, 0, 0.25);
	}

	.invert :global(.section-link .n),
	.invert :global(.section-link:hover) {
		color: #158a3f;
	}

	.invert :global(.section-link:hover) {
		border-top-color: #158a3f;
	}
</style>
