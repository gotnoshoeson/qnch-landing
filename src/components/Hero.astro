---
import InstallCommand from './InstallCommand.astro';
---

<section class="hero noise">
	<canvas
		class="hero-static"
		data-static-field
		data-px="3"
		data-density="0.34"
		data-fps="12"
		data-mint="0"
		aria-hidden="true"></canvas>

	<div class="hero-inner">
		<p class="kicker">
			<span class="stamp">beta live</span>
			<span class="kicker-text plate">launching 2026</span>
		</p>

		<h1 class="pair">
			<span class="half">DIY streaming</span>
			<span class="half">Patronage</span>
			<span class="join">Together at last</span>
		</h1>

		<p class="lede hero-lede">
			<span class="plate"
				>Station is a music streaming network for the DIY minded. Fans stream <strong
					>directly off your machine</strong
				>. Payments are minimally extractive.</span
			>
		</p>

		<InstallCommand id="hero-command" />

		<p class="fineprint">
			<span class="plate"
				>Preview and tinker for free. Everything works exactly as it will at launch, on a network
				built for practice. <a
				href="https://docs.qnch.network"
				target="_blank"
					rel="noopener noreferrer">Read the docs →</a
				></span
			>
		</p>
	</div>

	<div class="scroll-hint" aria-hidden="true">
		<span class="plate">01</span>
		<span class="tick"></span>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: calc(100svh - 3.5rem);
		display: flex;
		align-items: center;
		padding: clamp(3.5rem, 9vw, 7rem) var(--gutter) clamp(5rem, 10vw, 8rem);
		overflow: hidden;
	}

	/* Same pixel scale and density as the mid-page divider, so the two read
	   as one motif rather than two effects. */
	.hero-static {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		background: #000;
		image-rendering: pixelated;
	}

	/* Dark backing that hugs the type instead of blanking the hero, so the
	   static stays visible everywhere it isn't competing with words.

	   box-decoration-break clones the box onto every wrapped line, so a
	   paragraph gets one block per line rather than one rectangle behind the
	   whole thing. Vertical padding is kept under (line-height - 1.2em) so
	   adjacent line boxes never overlap — two translucent blocks stacking
	   would print a darker band across the text. */
	.plate {
		background: rgba(0, 0, 0, 0.66);
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
		padding: 0.15em 0.5em;
	}

	/* Centred, against the brief's usual rule, because the symmetry is the
	   argument here: two things of equal weight, joined. */
	.hero-inner {
		position: relative;
		z-index: 2;
		max-width: 78rem;
		margin: 0 auto;
		width: 100%;
		text-align: center;
	}

	.kicker {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.9rem;
		flex-wrap: wrap;
		margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
		max-width: none;
	}

	/* Transparent by default, which the static shows straight through. */
	.hero .stamp {
		background: rgba(0, 0, 0, 0.66);
	}

	.kicker-text {
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.92);
	}

	/* ---- the pair --------------------------------------------------- */

	/* Two halves that the industry ships separately, set at equal weight and
	   held inside one frame. The frame is the claim. */
	h1 {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		max-width: 58rem;
		margin: 0 auto clamp(2rem, 4vw, 2.75rem);
		border: 1px solid var(--rule-strong);
		background: rgba(0, 0, 0, 0.72);
		font-family: var(--display);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: -0.035em;
		line-height: 0.9;
		font-size: clamp(1.5rem, 5.2vw, 3.5rem);
	}

	.half {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: clamp(2.5rem, 6vw, 4.25rem) clamp(1rem, 3vw, 2rem);
		min-height: clamp(8.5rem, 20vw, 13rem);
	}

	/* The divide the frame is arguing against. */
	.half:first-child {
		border-right: 1px solid var(--rule-strong);
	}

	/* Sits on the seam and knocks a hole in it. The join interrupting the
	   divide is the whole point, made as layout rather than stated. */
	.join {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%) rotate(-1.5deg);
		background: var(--black);
		border: 1px solid var(--mint-rule);
		color: var(--mint);
		font-family: var(--mono);
		font-size: clamp(0.58rem, 1.5vw, 0.72rem);
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		line-height: 1;
		padding: 0.55rem 0.85rem;
		white-space: nowrap;
	}

	/* ---- everything under it ---------------------------------------- */

	.hero-lede {
		line-height: 1.7;
		max-width: 52ch;
		margin: 0 auto clamp(2rem, 4vw, 2.75rem);
	}

	.hero-lede strong {
		font-weight: 700;
		color: var(--white);
	}

	/* Centred as a block, but a terminal command still reads left to right.
	   :global because the markup belongs to InstallCommand. */
	.hero :global(.cmd) {
		background: var(--black);
		margin: 0 auto;
		text-align: left;
	}

	.fineprint {
		margin: 1.25rem auto 0;
		font-size: 0.75rem;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.92);
		max-width: 56ch;
	}

	.fineprint a {
		color: var(--mint);
		text-decoration: none;
		white-space: nowrap;
	}

	.fineprint a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.scroll-hint {
		position: absolute;
		bottom: clamp(1.5rem, 3vw, 2.5rem);
		right: var(--gutter);
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.66rem;
		letter-spacing: 0.2em;
		color: var(--gray-dim);
	}

	.tick {
		display: block;
		width: clamp(2rem, 6vw, 4rem);
		height: 1px;
		background: var(--rule-strong);
	}

	/* Stacked, the divide becomes horizontal — the join still lands on it. */
	@media (max-width: 40rem) {
		h1 {
			grid-template-columns: 1fr;
		}

		.half {
			min-height: 0;
			padding: clamp(2rem, 9vw, 2.75rem) 1rem;
		}

		.half:first-child {
			border-right: 0;
			border-bottom: 1px solid var(--rule-strong);
		}

		.scroll-hint {
			display: none;
		}
	}
</style>

<script>
	import { mountStaticFields } from '../scripts/staticField';

	mountStaticFields();
</script>
