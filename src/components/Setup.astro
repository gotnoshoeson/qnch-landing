---
const steps = [
	{
		n: '01',
		title: 'Get a server',
		body: "Intimidating? It's actually really simple. Providers start around $4 a month. Get a domain or use your existing one.",
		note: 'No domain of your own? The installer will help you set up a free DuckDNS subdomain instead.',
	},
	{
		n: '02',
		title: 'Run one command',
		body: "Copy the install command to run the interactive installer. Answer a few questions, the installer does the hard, scary stuff for you.",
		note: '<a href="https://docs.qnch.network" target="_blank" rel="noopener noreferrer">docs.qnch.network</a> has step by step instructions. You can do this, we believe in you.',
	},
	{
		n: '03',
		title: 'Log in and publish',
		body: "Use your dashboard to onboard onto the network. You're ready to upload and publish your work; no platform permissions or distributor headaches.",
		note: 'The artist dashboard has everything you need to publish and monetize your music without subscriptions.',
	},
];
---

<section class="section" id="setup">
	<div class="wrap">
		<span class="numeral" aria-hidden="true">02</span>

		<p class="eyebrow">Setup</p>
		<h2>DIY toolkit for DIY musicians</h2>

		<ol class="steps">
			{
				steps.map((step) => (
					<li class="step">
						<span class="n" aria-hidden="true">
							{step.n}
						</span>
						<div class="step-body">
							<h3>{step.title}</h3>
							<p>{step.body}</p>
							<p class="note" set:html={step.note} />
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.steps {
		list-style: none;
		margin-top: clamp(2.5rem, 5vw, 3.5rem);
	}

	.step {
		display: grid;
		grid-template-columns: minmax(4.5rem, 9rem) 1fr;
		gap: clamp(1rem, 4vw, 3rem);
		padding: clamp(1.75rem, 3.5vw, 2.75rem) 0;
		border-top: 1px solid var(--rule);
		align-items: start;
	}

	.step:last-child {
		border-bottom: 1px solid var(--rule);
	}

	.n {
		font-family: var(--display);
		font-size: clamp(2.5rem, 7vw, 5rem);
		line-height: 0.8;
		letter-spacing: -0.04em;
		color: transparent;
		-webkit-text-stroke: 1px var(--mint);
		user-select: none;
	}

	/* Nudge each numeral further off the axis as you descend. */
	.step:nth-child(2) .n {
		transform: translateX(0.5rem) rotate(-1deg);
	}

	.step:nth-child(3) .n {
		transform: translateX(1rem) rotate(-2deg);
	}

	.step-body h3 {
		margin-bottom: 0.85rem;
	}

	.step-body p {
		color: rgba(255, 255, 255, 0.82);
	}

	.note {
		margin-top: 0.9rem;
		font-size: 0.72rem;
		line-height: 1.6;
		color: var(--gray);
		border-left: 1px solid var(--mint-rule);
		padding-left: 0.85rem;
		max-width: 44ch;
	}

	.note :global(a) {
		color: var(--mint);
		text-decoration: none;
		border-bottom: 1px solid var(--mint-rule);
	}

	.note :global(a:hover) {
		border-bottom-color: var(--mint);
	}

	@media (max-width: 40rem) {
		.step {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.step .n {
			transform: none !important;
		}
	}
</style>
