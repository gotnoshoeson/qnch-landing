---
import InstallCommand from './InstallCommand.astro';

const routes = [
	{
		label: 'Read the docs',
		body: 'The full walkthrough — server, domain, wallet, first release.',
		href: 'https://docs.qnch.network',
	},
	{
		label: 'Hear it working',
		body: 'The listener app, running on testnet. Nothing to install.',
		href: 'https://beta.qnch.network/artist/gnso',
	},
	{
		label: 'Ask us anything',
		body: 'Argue with the economics or just say hi. We’re in there.',
		href: 'https://t.me/+EwzB7vuSRZozYTEx',
	},
];
---

<section class="section start noise" id="start">
	<div class="wrap">
		<span class="numeral" aria-hidden="true">08</span>

		<p class="eyebrow">Start</p>
		<h2>the new way to DIY</h2>

		<div class="cmd-wrap">
			<InstallCommand id="start-command" />
			<p class="under">
				<span class="stamp">testnet live</span>
				<span
					>Free tokens from a faucet, worth nothing. Deploy contracts, take fake payments, make
					mistakes. Mainnet hasn't launched — we'll say so the moment it does.</span
				>
			</p>
		</div>

		<div class="routes">
			{
				routes.map((route) => (
					<a class="route" href={route.href} target="_blank" rel="noopener noreferrer">
						<span class="route-label">
							{route.label}
							<span class="arrow" aria-hidden="true">
								→
							</span>
						</span>
						<span class="route-body">{route.body}</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.start {
		padding-bottom: clamp(5rem, 12vw, 10rem);
	}

	.cmd-wrap {
		margin-top: clamp(2rem, 4vw, 3rem);
	}

	.under {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
		flex-wrap: wrap;
		margin-top: 1.25rem;
		font-size: 0.72rem;
		line-height: 1.7;
		color: var(--gray);
		max-width: 54rem;
	}

	.under span:last-child {
		flex: 1;
		min-width: 16rem;
	}

	.routes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1px;
		background: var(--rule);
		border: 1px solid var(--rule);
		margin-top: clamp(3rem, 6vw, 4.5rem);
	}

	.route {
		background: var(--black);
		padding: clamp(1.35rem, 2.5vw, 1.85rem);
		text-decoration: none;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		transition: background 0.15s ease;
	}

	.route:hover,
	.route:focus-visible {
		background: rgba(173, 235, 179, 0.05);
	}

	.route-label {
		font-family: var(--display);
		font-size: 1.15rem;
		text-transform: uppercase;
		letter-spacing: -0.02em;
		color: var(--mint);
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.arrow {
		font-family: var(--mono);
		font-size: 0.85rem;
		transition: transform 0.15s ease;
	}

	.route:hover .arrow {
		transform: translateX(0.25rem);
	}

	.route-body {
		font-size: 0.78rem;
		line-height: 1.65;
		color: var(--gray);
	}
</style>
